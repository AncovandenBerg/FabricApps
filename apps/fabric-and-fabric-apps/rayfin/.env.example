# Copy to rayfin/.env and fill in real values before running `rayfin dev` / `rayfin up`.
# RAYFIN_PUBLIC_* variables are auto-generated by the Rayfin CLI per deployment — do not set them here.

# Comma-separated list of email addresses allowed to control the presentation
# (advance stages, open/close polls). Both the Entra UPN and the primary SMTP
# address may show up in claims.email depending on tenant configuration, so
# list every address you sign in with.
PRESENTER_EMAILS=you@yourtenant.onmicrosoft.com,you@yourcompany.com
